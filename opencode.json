{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true,
      "headers": { "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}" }
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@henkey/postgres-mcp-server"],
      "enabled": true,
      "environment": { "POSTGRES_CONNECTION_STRING": "{env:POSTGRES_CONNECTION_STRING}" }
    },
    "vercel": {
      "type": "local",
      "command": ["npx", "-y", "@vercel/mcp-adapter"],
      "enabled": true,
      "environment": { "VERCEL_TOKEN": "{env:VERCEL_TOKEN}" }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": { "Authorization": "Bearer {env:GITHUB_TOKEN}" }
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    }
  }
}